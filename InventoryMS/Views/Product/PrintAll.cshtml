@model List<Product>
    
<table class="table table-dark">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.Description</td>
                    <td>@x.Price</td>
                    <td>@x.Quantity</td>
                    <td>@x.Category</td>
                </tr>
            }
        </tbody>
    }

    else
    {
        <tbody>
            <tr>
                <td colspan="5" class="text-center">No product is available.</td>
            </tr>
        </tbody>
    }
</table>