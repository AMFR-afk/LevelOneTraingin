@model List<Product>
    
<table class="table ">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th colspan="2"></th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.Description</td>
                    <td>@x.Price</td>
                    <td>@x.Quantity</td>
                    <td>@x.Category</td>
                    <td><a asp-action="EditProduct" asp-controller="Product" asp-route-id="@x.Id">Edit</a></td>
                    <td><a asp-action="DeleteProduct" asp-controller="Product" asp-route-id="@x.Id" class="btn btn-red">Delete</a></td>
                </tr>
            }
        </tbody>
    }

    else
    {
        <tbody>
            <tr>
                <td colspan="6" class="text-center">No product is available.</td>
            </tr>
        </tbody>
    }

    <tbody>
        <tr>
            <td colspan="6" class="text-center"><a asp-action="AddProduct" asp-controller="Product"
                                                       class="btn btn-dark">Add Product</a></td>
            </tr>
        </tbody>
    </table>